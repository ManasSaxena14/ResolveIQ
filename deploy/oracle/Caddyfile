# Caddy reverse proxy for ResolveIQ. setup.sh replaces @DOMAIN@ and installs it as
# /etc/caddy/Caddyfile. Caddy gets and renews a free Let's Encrypt certificate.
@DOMAIN@ {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8000 {
		# Pass streamed drafts (server-sent events) through without buffering.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
