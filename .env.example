# Copy this file to .env and fill in only the keys you need.
# .env is listed in .gitignore and must never be committed.

# Hosted language model providers (only required when llm.provider is not "ollama").
# Use their free tiers: create each key on an account without billing set up.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Hosted demo: use an API provider instead of the configured one (gemini, groq, openrouter)
# RESOLVEIQ_LLM_PROVIDER=groq

# Hosted demo: Hugging Face repositories the models are downloaded from at startup
# RESOLVEIQ_SEMANTIC_REPO=<user>/resolveiq-semantic
# RESOLVEIQ_RISK_REPO=<user>/resolveiq-escalation-risk

# API keys for programmatic clients, comma separated. Keyed callers get a higher rate
# limit (service.rate_limit). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# RESOLVEIQ_API_KEYS=

# Optional: point to a different config file
# RESOLVEIQ_CONFIG=configs/config.yaml
